{
    "night3_start": {
        "name": "{name}",
        "text": "*방에 돌아왔다. 무거운 하루였다.*"
    },
    "night3_start_2": {
        "name": "{name}",
        "text": "*핸드폰을 본다.*"
    },
    "night3_faithful_check": {
        "name": "{name}",
        "text": "*메시지가 와 있다.*"
    },
    "night3_faithful_msg_seo_1": {
        "name": "서연",
        "text": "오늘 본 거, 비밀이야"
    },
    "night3_faithful_msg_seo_2": {
        "name": "서연",
        "text": "...근데 또 와도 돼"
    },
    "night3_faithful_msg_seo_3": {
        "name": "{name}",
        "text": "*'또 와도 돼'. — 이 사람한테는 이게 '와 줘'와 같은 말이다.*"
    },
    "night3_faithful_msg_yuna_1": {
        "name": "{name}",
        "text": "*유나가 쪽지 사진을 보냈다. 노트에 쓰인 한 줄.*"
    },
    "night3_faithful_msg_yuna_2": {
        "name": "유나",
        "text": "그 소설, 결말은 아직 안 정했어"
    },
    "night3_faithful_msg_dain_1": {
        "name": "다인",
        "text": "발목 괜찮냐고 물어볼 거면 직접 와서 물어봐ㅋㅋ"
    },
    "night3_faithful_msg_dain_2": {
        "name": "다인",
        "text": "아 근데 고마워"
    },
    "night3_faithful_msg_dain_3": {
        "name": "{name}",
        "text": "*느낌표가 하나도 없다. 'ㅋㅋ'로 위장했지만 — 진심이 보인다.*"
    },
    "night3_dream_1": {
        "name": "{name}",
        "text": "*꿈을 꿨다. — 누군가와 나란히 걷고 있었다.*"
    },
    "night3_dream_2": {
        "name": "{name}",
        "text": "*얼굴은 보이지 않는데, 옆에 있다는 것만으로 마음이 편했다.*"
    },
    "night3_dream_3": {
        "name": "{name}",
        "text": "*좋은 꿈이었다.*"
    },
    "night3_cheat_msg_1": {
        "name": "{name}",
        "text": "*방에 돌아왔다. 무거운 하루였다. 핸드폰을 본다.*"
    },
    "night3_cheat_msg_2": {
        "name": "서연",
        "text": "나한테만 그래줘"
    },
    "night3_cheat_msg_3": {
        "name": "서연",
        "text": "...부탁이야"
    },
    "night3_cheat_msg_4": {
        "name": "유나",
        "text": "...거짓말은 하지 마"
    },
    "night3_cheat_msg_5": {
        "name": "유나",
        "text": "그것만"
    },
    "night3_nightmare_1": {
        "name": "{name}",
        "text": "*잠이 들었다. — 꿈.*"
    },
    "night3_nightmare_2": {
        "name": "{name}",
        "text": "*어둠 속에 서 있다. 아무것도 보이지 않는다.*"
    },
    "night3_nightmare_3": {
        "name": "서연",
        "text": "약속했잖아. 나한테만이라고..."
    },
    "night3_nightmare_4": {
        "name": "유나",
        "text": "거짓말하지 말라고 했지."
    },
    "night3_nightmare_5": {
        "name": "다인",
        "text": "온다면서. 기다렸는데."
    },
    "night3_nightmare_6": {
        "name": "{name}",
        "text": "*세 방향에서 손이 보인다. 어둠 속에서 희미하게.*"
    },
    "night3_nightmare_choice": {
        "name": "{name}",
        "text": "*누구의 손을 잡을 것인가.*",
        "choices": [
            "서연의 손을 잡는다",
            "유나의 손을 잡는다",
            "다인의 손을 잡는다"
        ]
    },
    "night3_nightmare_end": {
        "name": "{name}",
        "text": "*손을 뻗었다. — 잡히지 않는다.*"
    },
    "night3_nightmare_end_2": {
        "name": "{name}",
        "text": "*모두 사라지고, 남은 건 어둠뿐.*"
    },
    "night3_nightmare_end_3": {
        "name": "{name}",
        "text": "*— 땀에 젖은 채 눈을 떴다. 새벽 3시. 천장이 보인다.*"
    },
    "night3_nightmare_end_4": {
        "name": "{name}",
        "text": "*내가 뭘 한 거지.*"
    },
    "night3_end": {
        "name": "{name}",
        "text": "*밤이 깊어간다...*"
    }
}
