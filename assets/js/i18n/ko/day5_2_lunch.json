{
    "tour_start": {
        "name": "시스템",
        "text": ""
    },

    "tour_seo_1": {
        "name": "나",
        "text": "*교문 앞에 나란히 선다. 첫날 서연이 기다리고 있던 바로 그 자리.*"
    },
    "tour_seo_2": {
        "name": "서연",
        "text": "\"여기서 처음 만났지.\""
    },
    "tour_seo_3": {
        "name": "나",
        "text": "\"그때 '과분한데'라고 했다가 혼날 뻔했어.\""
    },
    "tour_seo_4": {
        "name": "서연",
        "text": "\"혼내진 않았잖아. — 그때부터 마음에 들었어.\""
    },
    "tour_seo_5": {
        "name": "나",
        "text": "\"첫날부터?\""
    },
    "tour_seo_6": {
        "name": "서연",
        "text": "\"...바람 때문에 들은 착각일 수도 있어.\""
    },
    "tour_seo_7": {
        "name": "나",
        "text": "*바람은 불지 않고 있다.*"
    },
    "tour_seo_8": {
        "name": "서연",
        "text": "\"졸업 후에도 누군가를 위해 일하는 사람이 되고 싶어.\""
    },
    "tour_seo_9": {
        "name": "나",
        "text": "\"학생회장 말고?\""
    },
    "tour_seo_10": {
        "name": "서연",
        "text": "\"학생회장이 아닌 나로서. — 네가 보여준 거야. 역할이 아니어도 괜찮다는 거.\""
    },
    "tour_seo_end": {
        "name": "나",
        "text": "*서연이 조용히 웃었다. 교문 위로 햇살이 비스듬히 내려앉는다.*"
    },

    "tour_yuna_1": {
        "name": "나",
        "text": "*도서관 열람실. Day 1에서 유나가 '시끄럽지 않으면 앉아도 돼'라고 했던 자리.*"
    },
    "tour_yuna_2": {
        "name": "유나",
        "text": "\"...여기.\""
    },
    "tour_yuna_3": {
        "name": "나",
        "text": "*유나가 그때와 같은 자리에 앉는다.*"
    },
    "tour_yuna_4": {
        "name": "나",
        "text": "\"여기서 처음 앉았지.\""
    },
    "tour_yuna_5": {
        "name": "유나",
        "text": "\"...그때 3권 집었잖아.\""
    },
    "tour_yuna_6": {
        "name": "나",
        "text": "\"아직 기억해?\""
    },
    "tour_yuna_7": {
        "name": "유나",
        "text": "\"다 기억해.\""
    },
    "tour_yuna_8": {
        "name": "나",
        "text": "*짧은 문장인데 — '다 기억해'에 5일치 감정이 들어 있다.*"
    },
    "tour_yuna_9": {
        "name": "유나",
        "text": "\"글을 쓰고 싶어.\""
    },
    "tour_yuna_10": {
        "name": "나",
        "text": "\"소설?\""
    },
    "tour_yuna_end": {
        "name": "유나",
        "text": "\"...네가 읽어줬으면 좋겠어. 첫 번째 독자.\""
    },

    "tour_dain_1": {
        "name": "나",
        "text": "*매점 벤치. Day 1에서 소보로빵을 먹었던 자리.*"
    },
    "tour_dain_2": {
        "name": "다인",
        "text": "\"여기서 가위바위보 했잖아!\""
    },
    "tour_dain_3": {
        "name": "나",
        "text": "\"네가 졌지.\""
    },
    "tour_dain_4": {
        "name": "다인",
        "text": "\"아직도 그 얘기 하냐?! — 아 근데 그때 소보로 진짜 맛있었다.\""
    },
    "tour_dain_5": {
        "name": "나",
        "text": "*다인이 잠깐 조용해진다.*"
    },
    "tour_dain_6": {
        "name": "다인",
        "text": "\"프로... 는 이제 모르겠지만.\""
    },
    "tour_dain_7": {
        "name": "나",
        "text": "\"......\""
    },
    "tour_dain_8": {
        "name": "다인",
        "text": "\"근데 가끔 불안해. 꿈 없는 사람이 될까 봐.\""
    },
    "tour_dain_9": {
        "name": "나",
        "text": "\"새로운 꿈 찾으면 되지.\""
    },
    "tour_dain_10": {
        "name": "다인",
        "text": "\"...그래. 네가 그렇게 말하니까 진짜 될 것 같다.\""
    },
    "tour_dain_end": {
        "name": "나",
        "text": "*웃는다. 반달 눈. — Day 1에서 처음 봤던 그 눈과 같은데, 깊이가 다르다.*"
    }
}
